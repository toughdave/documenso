# Copy to a production secret store or to an untracked `.env` on the server.
# Do not commit real values.

POSTGRES_USER=documenso
POSTGRES_PASSWORD=replace-with-long-random-password
POSTGRES_DB=documenso

PORT=3000
DOCUMENSO_IMAGE=toughdave/documenso-anchor:latest

# Public browser origin for the signing app.
NEXTAUTH_URL=https://sign.theanchorcoach.com
NEXT_PUBLIC_WEBAPP_URL=https://sign.theanchorcoach.com

# Internal URL used by Documenso server-side rendering and workers.
# For Docker Compose this should normally be the service URL.
NEXT_PRIVATE_INTERNAL_WEBAPP_URL=http://documenso:3000

# Generate unique production values; never reuse local/dev secrets.
NEXTAUTH_SECRET=replace-with-32-plus-char-secret
NEXT_PRIVATE_ENCRYPTION_KEY=replace-with-32-plus-char-secret
NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY=replace-with-different-32-plus-char-secret

NEXT_PRIVATE_DATABASE_URL=postgres://documenso:replace-with-long-random-password@database:5432/documenso
NEXT_PRIVATE_DIRECT_DATABASE_URL=postgres://documenso:replace-with-long-random-password@database:5432/documenso

# Keep database upload transport for the first production cut unless an S3/R2
# Documenso upload bucket has been explicitly provisioned.
NEXT_PUBLIC_UPLOAD_TRANSPORT=database

# Transactional signing email. Use a verified sender domain before production.
NEXT_PRIVATE_SMTP_TRANSPORT=smtp-auth
NEXT_PRIVATE_SMTP_HOST=smtp.example.com
NEXT_PRIVATE_SMTP_PORT=587
NEXT_PRIVATE_SMTP_USERNAME=replace-with-smtp-username
NEXT_PRIVATE_SMTP_PASSWORD=replace-with-smtp-password
NEXT_PRIVATE_SMTP_SECURE=false
NEXT_PRIVATE_SMTP_FROM_NAME=Anchor Coaching
NEXT_PRIVATE_SMTP_FROM_ADDRESS=no-reply@theanchorcoach.com

# Required for production-grade signed PDFs.
NEXT_PRIVATE_SIGNING_TRANSPORT=local
NEXT_PRIVATE_SIGNING_LOCAL_FILE_PATH=/opt/documenso/cert.p12
NEXT_PRIVATE_SIGNING_PASSPHRASE=replace-with-certificate-passphrase

# Optional but recommended once production smoke is complete.
NEXT_PUBLIC_DISABLE_SIGNUP=true
DOCUMENSO_DISABLE_TELEMETRY=true

# One-time integration configuration script inputs.
ANCHOR_APP_URL=https://www.theanchorcoach.com
ANCHOR_INTEGRATION_USER_EMAIL=admin@theanchorcoach.com
# Optional when the integration user owns multiple teams.
# ANCHOR_INTEGRATION_TEAM_ID=
# ANCHOR_INTEGRATION_TEAM_NAME=
ANCHOR_DOCUMENSO_WEBHOOK_SECRET=replace-with-same-secret-used-in-anchor
ANCHOR_DOCUMENSO_TOKEN_NAME=Anchor Production Integration
# Set true only when intentionally creating a new API token.
ANCHOR_DOCUMENSO_CREATE_API_TOKEN=false
